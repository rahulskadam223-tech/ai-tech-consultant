# Copy to .env and fill in. All services read this file from the repo root.
ANTHROPIC_API_KEY=sk-ant-...
# Or use Amazon Bedrock instead (takes precedence when set). Models map to global.anthropic.* inference profiles.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=ap-southeast-2

# Models (swap for evals)
ANSWER_MODEL=claude-sonnet-4-5
CAPTION_MODEL=claude-haiku-4-5

# Task 1 - knowledge brain
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
MAX_PAGES=150
MAX_IMAGES=40
CRAWL_CONCURRENCY=3
CRAWL_DELAY_SECONDS=0.5
MAX_ATTEMPTS=3
SCORE_THRESHOLD=0.35
TOP_K=6
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATA_DIR=./data
PROMPTS_DIR=../prompts/v1
TASK1_URL=http://localhost:8001

# Task 2 - inbox agent
CLASSIFY_MODEL=claude-haiku-4-5
DRAFT_MODEL=claude-sonnet-4-5
PROMPT_VERSION=v1
AUTO_SEND_THRESHOLD=20
